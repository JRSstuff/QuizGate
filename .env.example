# ==============================================================================
# QuizGate Environment Configuration Example
# Copy this file to `.env` for local development and fill in your credentials.
# Never commit your real `.env` file to GitHub.
# ==============================================================================

# --- Offline Vault & QR Signing Keys ---
# Generate random hex values (e.g. `openssl rand -hex 32`)
NEXT_PUBLIC_QUIZGATE_VAULT_KEY=
NEXT_PUBLIC_QUIZGATE_QR_KEY=

# --- Optional: Supabase Cloud Sync ---
# Leave blank to run purely in Offline PWA + Encrypted File mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret (NEVER expose with NEXT_PUBLIC_ or in client code)
SUPABASE_SERVICE_ROLE_KEY=

# Optional server receipt signing key
VERIFICATION_HMAC_SECRET=
