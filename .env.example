# ==============================================================================
# QuizGate Environment Configuration Example
# Copy this file to `.env.local` (or `.env`) for local development.
# Never commit your real `.env` or `.env.local` files to GitHub.
# ==============================================================================

# --- Offline Vault & QR Signing Keys ---
# Generate random hex values (e.g. `openssl rand -hex 32`)
NEXT_PUBLIC_QUIZGATE_VAULT_KEY=
NEXT_PUBLIC_QUIZGATE_QR_KEY=

# --- Optional: Supabase Cloud Sync ---
# Leave blank to run purely in Offline PWA + Encrypted File mode.
# Supports either NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (`sb_publishable_...`)
# or legacy NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret (NEVER expose with NEXT_PUBLIC_ or in client code)
# Used by Next.js /api/student/* routes for student_sign_in and live sync.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server receipt signing key
VERIFICATION_HMAC_SECRET=
